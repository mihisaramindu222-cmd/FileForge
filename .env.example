NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=your-email@example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Alternative name accepted by the server if your Supabase project uses the legacy service-role key name.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PRICE_ID=your-stripe-price-id
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_ID=1234567890
BLOB_READ_WRITE_TOKEN=
# Optional: force the ImageMagick executable name when your runtime uses a non-standard binary.
# FILEFORGE_IMAGE_COMMAND=magick
CRON_SECRET=

# Required for existing Vercel projects if the deployment is over the standard Function package-size limit.
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Used to cryptographically bind download links to a 1-hour server-side expiry.
DOWNLOAD_SIGNING_SECRET=replace-with-a-long-random-secret
